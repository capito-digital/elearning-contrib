<div class="component__inner imagePairing__inner">
  {{> component this}}

  {{#if body}}
    <div class="component__body imagePairing__body">{{{body}}}</div>
  {{/if}}

  <div class="component__widget imagePairing__widget">
    <div class="imagePairing__split">
      <div class="imagePairing__col imagePairing__col--left">
        <div class="imagePairing__colHeader">{{_globals._components._imagePairing.leftColumnLabel}}</div>
        <ul class="imagePairing__list imagePairing__list--left js-left-list" aria-label="Left items"></ul>
      </div>
      <div class="imagePairing__divider" aria-hidden="true"></div>
      <div class="imagePairing__col imagePairing__col--right">
        <div class="imagePairing__colHeader">{{_globals._components._imagePairing.rightColumnLabel}}</div>
        <ul class="imagePairing__list imagePairing__list--right js-right-list" aria-label="Right items"></ul>
      </div>
    </div>

    <div class="btn__container"></div>
  </div>
</div>
