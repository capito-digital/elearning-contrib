<div class="bn-chat__inner" role="dialog" aria-label="Course Chat" aria-live="polite">
  <div class="bn-chat__header" aria-live="off">
    <span class="bn-chat__title">💬 Course Chat</span>
    <button class="bn-chat__toggle js-chat-toggle" aria-expanded="true" title="Chat ein-/ausklappen">−</button>
  </div>
  <div class="bn-chat__body">
    <div class="bn-chat__messages" aria-live="polite"></div>
    <div class="bn-chat__input-area">
      <textarea class="bn-chat__input js-chat-input transcribe-content" rows="3" placeholder="{{placeholder}}" aria-label="{{placeholderAria}}"></textarea>
    </div>
  </div>
</div>
